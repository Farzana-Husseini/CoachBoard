@model CoachBoard.ViewModels.PagerViewModel
@{
    Dictionary<string, string> Link(int seite)
    {
        var d = new Dictionary<string, string>(Model.Route);
        d["page"] = seite.ToString();
        return d;
    }

    var von = Math.Max(1, Model.Page - 2);
    var bis = Math.Min(Model.TotalPages, Model.Page + 2);
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Seiten">
        <ul class="pagination">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="Link(Math.Max(1, Model.Page - 1))">Zurück</a>
            </li>

            @if (von > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                       asp-all-route-data="Link(1)">1</a>
                </li>
                if (von > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (var p = von; p <= bis; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                       asp-all-route-data="Link(p)">@p</a>
                </li>
            }

            @if (bis < Model.TotalPages)
            {
                if (bis < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                       asp-all-route-data="Link(Model.TotalPages)">@Model.TotalPages</a>
                </li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="Link(Math.Min(Model.TotalPages, Model.Page + 1))">Weiter</a>
            </li>
        </ul>
    </nav>
}