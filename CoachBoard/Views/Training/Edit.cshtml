@model CoachBoard.ViewModels.TrainingFormViewModel
@{
    ViewData["Title"] = "Trainingseinheit bearbeiten";
}

<h2>Trainingseinheit bearbeiten</h2>
<form asp-action="Edit" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <partial name="_TrainingFelder" model="Model" />
    <button class="btn btn-primary">Speichern</button>
    <a asp-action="Index" class="btn btn-link">Abbrechen</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}